msgstr "Sube una imagen JPEG, PNG o WebP."

msgid "The image content type does not match its extension."
msgstr "El tipo de contenido de la imagen no coincide con su extensión."

msgid "Images must be 8,000 pixels or smaller in either dimension."
msgstr "Las imágenes deben medir como máximo 8.000 píxeles en cualquier dimensión."

msgid "Images must contain 40 million pixels or fewer."
msgstr "Las imágenes deben contener 40 millones de píxeles o menos."

msgid "Animated images are not supported."
msgstr "No se admiten imágenes animadas."

